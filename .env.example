# Core
DATABASE_URL=postgresql://jfmcss:jfmcss@localhost:5432/jfmcss
APP_URL=http://localhost:3000
SESSION_DAYS=7

# First login only: when users table is empty, these credentials create the first SUPER_ADMIN.
BOOTSTRAP_ADMIN_EMAIL=admin@jfmcss.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ADMIN_NAME=JFMCSS Admin

# Protected document storage (use a persistent volume in production)
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=15

# SMTP (optional; in-app notifications still work without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=JFMCSS <notificaciones@jfmcss.com>

# Meta WhatsApp Cloud API (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=1

# DGII / e-CF adapter (leave disabled until JFMCSS has valid authorization/certificates)
ECF_ENABLED=false
ECF_PROVIDER_URL=
ECF_PROVIDER_TOKEN=
ECF_RNC=

# Cron endpoint protection
CRON_SECRET=replace-with-long-random-secret
