# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://jfmcss:jfmcss@localhost:5432/jfmcss
APP_URL=http://localhost:3000
SESSION_DAYS=7
# Set true when Postgres requires TLS (most managed providers).
PG_SSL=false
PG_POOL_MAX=10

# ─── docker compose (only read by docker-compose.yml) ────────────────────────
POSTGRES_DB=jfmcss
POSTGRES_USER=jfmcss
# REQUIRED: generate with `openssl rand -hex 24`
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
APP_PORT=3000

# ─── docker-compose.prod.yml overlay (Traefik edge routing) ──────────────────
EDGE_NETWORK=winu-bot-signal-network
CONTROL_HOST=control.jfmcss.com

# ─── First login only ───────────────────────────────────────────────────────
# When the users table is empty these credentials create the first SUPER_ADMIN.
# Rotate/remove BOOTSTRAP_ADMIN_PASSWORD from deployment secrets afterwards.
BOOTSTRAP_ADMIN_EMAIL=admin@jfmcss.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=JFMCSS Admin

# ─── Auth hardening ─────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300

# ─── Protected document storage ─────────────────────────────────────────────
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=15

# ─── SMTP (optional; in-app notifications still work without it) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=JFMCSS <notificaciones@jfmcss.com>

# ─── Meta WhatsApp Cloud API (optional) ─────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=1

# ─── DGII / e-CF adapter ────────────────────────────────────────────────────
# Leave disabled until JFMCSS has valid authorization/certificates/provider.
# When ECF_ENABLED=true the adapter fails closed if the provider is not configured.
ECF_ENABLED=false
ECF_PROVIDER_URL=
ECF_PROVIDER_TOKEN=
ECF_RNC=

# ─── Notifications outbox ──────────────────────────────────────────────────
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BATCH=50

# ─── Cron endpoint protection ──────────────────────────────────────────────
# generate with `openssl rand -hex 32`
CRON_SECRET=
